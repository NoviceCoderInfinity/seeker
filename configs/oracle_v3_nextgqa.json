{
 "name": "oracle_v3_nextgqa",
 "qa_path": "data/processed/heldout/nextgqa_heldout.jsonl",
 "frames_path": "data/indices/nextgqa_siglip_frames.jsonl",
 "output_dir": "runs/oracle_v3_nextgqa",
 "budgets": [
  4,
  8
 ],
 "policies": [
  "oracle_span",
  "oracle_span_context",
  "curator_oracle_probe"
 ],
 "answerer": {
  "kind": "openai_compat",
  "endpoint": "http://localhost:8480",
  "model": "models/qwen2_5_vl_7b",
  "send_images": true,
  "max_images": 64,
  "timeout_seconds": 900,
  "prompt_style": "v3"
 },
 "policy": {
  "max_hops": 4,
  "retrieve_per_hop": 6,
  "seed_uniform": 2,
  "sufficiency_threshold": 0.72
 },
 "retrieval_recall_at_k": [
  4,
  8,
  16
 ]
}
