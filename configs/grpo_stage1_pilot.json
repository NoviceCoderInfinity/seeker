{
  "stage": "lora_grpo_pilot",
  "base_models": [
    "models/qwen2_5_vl_7b",
    "models/qwen3_vl_8b_instruct"
  ],
  "train_data": "data/rl/vidcurator_train_sft.jsonl",
  "eval_data": "data/rl/vidcurator_val_sft.jsonl",
  "output_root": "runs/grpo",
  "verl": {
    "repo": "${VERL_ROOT}",
    "entrypoint": "examples/grpo_trainer/run_qwen2_5_vl_7b_fsdp.sh",
    "trainer": "grpo",
    "lora_rank": 32,
    "lora_alpha": 32,
    "global_batch_size": 16,
    "rollout_n": 1,
    "rollout_tp": 2,
    "max_turns": 4,
    "epochs": 1,
    "train_max_samples": 2048,
    "val_max_samples": 128,
    "save_freq": 16,
    "test_freq": 16
  },
  "reward_weights": {
    "correct": 1.0,
    "num_frames": 0.1,
    "num_retrievals": 0.05,
    "num_probes": 0.05,
    "frame_evidence_precision": 0.3,
    "calibrated_stop": 0.2,
    "format_valid": 0.1
  },
  "budget_curriculum": [4, 8, 16],
  "notes": [
    "Pilot GRPO: 2048 train / 128 val, 1 epoch, batch 32, rollout n=2.",
    "Skips blocking pre-train validation (see jobs/04_grpo_dgx.sh).",
    "Full run uses configs/grpo_stage1.json after pilot gates pass."
  ]
}
